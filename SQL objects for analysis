--Readmission view
CREATE VIEW dbo.vw_readmissions
AS
SELECT
	Facility_ID,
	Facility_Name,
	State,
	Measure_Name,
	Number_of_Discharges,
	Number_of_Readmissions,
	Excess_Readmission_Ratio
FROM EDAC.dbo.Readmissions
WHERE Number_of_Discharges IS NOT NULL
AND Number_of_Readmissions IS NOT NULL

